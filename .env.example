
# Resend, for the order notification that tells you what to buy at CJ.
# Create the key at https://resend.com/api-keys with "Sending access".
# Without it the shop still works: the order is logged, nobody is emailed.
RESEND_API_KEY=

# Optional. Defaults to hello.havenhuys@gmail.com and to Resend's shared
# onboarding@resend.dev sender, which only delivers to the address that owns
# the Resend account. Set a sender on your own domain once one is verified.
ORDER_NOTIFICATION_TO=
ORDER_NOTIFICATION_FROM=
